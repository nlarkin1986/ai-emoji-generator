## Set up Replicate: https://replicate.com
REPLICATE_API_TOKEN=

## Generate a random secret for the webhook: https://generate-secret.vercel.app/32
WEBHOOK_SECRET=

## Forward Requests Locally (local dev)
NGROK_URL=

## Set up Vercel Blob: https://vercel.com/docs/storage/vercel-blob/quickstart
BLOB_READ_WRITE_TOKEN=

## Set up Vercel KV: https://vercel.com/docs/storage/vercel-kv/quickstart
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

## Prisma: https://www.prisma.io/docs/reference/database-reference/connection-urls#env
## Set up PlanetScale: https://planetscale.com/docs/tutorials/planetscale-quick-start-guide
DATABASE_URL=

## SUPER BEER PONG party leaderboard (/beerpong, API: /api/beerpong/scores)
## Uses the Vercel KV vars above OR an Upstash Redis database (either pair works).
## With neither configured the API answers 503 and the game keeps scores on each device.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
## Secret for resetting the board: curl -X DELETE -H "x-admin-key: $BEERPONG_ADMIN_KEY" https://<host>/api/beerpong/scores
## Generate one with: openssl rand -hex 24   (leave empty to disable DELETE)
BEERPONG_ADMIN_KEY=
## Optional HMAC secret for run tokens (falls back to one derived from BEERPONG_ADMIN_KEY / the KV token)
BEERPONG_SECRET=
