## Shared leaderboard storage: connect Upstash Redis (Vercel Marketplace) or Vercel KV to the project.
## Either pair works; Vercel sets them automatically when you connect the store.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

## Secret for the admin list / reset: curl -X DELETE -H "x-admin-key: $BEERPONG_ADMIN_KEY" https://<host>/api/beerpong/scores
BEERPONG_ADMIN_KEY=
## Optional HMAC secret for run tokens (falls back to one derived from BEERPONG_ADMIN_KEY / the KV token)
BEERPONG_SECRET=
